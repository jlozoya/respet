# --- Entorno -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api

# --- Base de datos -----------------------------------------------------------
DATABASE_URL="mongodb://127.0.0.1:27019/respet?directConnection=true"
# Conexiones simultáneas del pool. Súbelo si la API atiende mucha concurrencia.
DATABASE_POOL_SIZE=20
# Base anterior en MySQL. Sólo la usa el volcado de datos a Mongo.
MYSQL_URL="mysql://root:secret@127.0.0.1:3306/respet"
# Contra una base remota, MySQL 8 autentica con caching_sha2_password y exige
# que la contraseña viaje protegida: añade `?ssl=true` —o `?ssl=skip-verify` si
# el certificado es autofirmado—, o entrega la clave pública del servidor con
# `?cachingRsaPublicKey=/ruta/public_key.pem`. En local no hace falta nada.

# Redis, opcional. Sin él los avisos en tiempo real y la presencia viven en la
# memoria del proceso, que basta con una sola instancia. `docker compose up`
# lo levanta en el 6380.
# REDIS_URL=redis://127.0.0.1:6380

# --- URLs públicas -----------------------------------------------------------
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:8100
CORS_ORIGINS=http://localhost:8100,http://localhost:4200,capacitor://localhost,ionic://localhost

# --- Sesiones ----------------------------------------------------------------
# Genera cada secreto con: openssl rand -base64 48
JWT_ACCESS_SECRET=cambia-esto-por-al-menos-32-caracteres-aleatorios
JWT_REFRESH_SECRET=cambia-esto-tambien-por-otros-32-caracteres
JWT_ACCESS_TTL=15m
# Días sin usar una sesión tras los que caduca; cada uso los renueva.
JWT_REFRESH_TTL_DAYS=30
# Vida máxima de una sesión, se use o no.
SESSION_ABSOLUTE_TTL_DAYS=180

# --- Verificación en dos pasos -----------------------------------------------
# Clave de 32 bytes en base64 con la que se cifran los secretos TOTP:
#   openssl rand -base64 32
# Obligatoria en producción; en desarrollo, si falta, se deriva del secreto
# de refresco.
MFA_ENCRYPTION_KEY=
MFA_ISSUER=Respet
TRUSTED_DEVICE_TTL_DAYS=30

# --- Acceso con proveedores externos -----------------------------------------
# Id de cliente web de OAuth de Google, para verificar el idToken de la app.
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Archivos ----------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_ROOT=storage/uploads
UPLOAD_MAX_MB=10
VIDEO_UPLOAD_MAX_MB=100
AUDIO_UPLOAD_MAX_MB=15
# FFmpeg saca la portada y la duración de los vídeos. Opcional: sin él los
# vídeos se guardan igual. Si no está en el PATH, indica dónde.
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
# FFPROBE_PATH=C:/ffmpeg/bin/ffprobe.exe

# --- API pública -------------------------------------------------------------
# El esquema se puede explorar también en producción: la API se ofrece a
# aplicaciones de terceros. Lo que protege al servidor son estos límites.
GRAPHQL_INTROSPECTION=true
GRAPHQL_MAX_DEPTH=12
GRAPHQL_MAX_COMPLEXITY=5000
OAUTH_ACCESS_TTL=1h
OAUTH_REFRESH_TTL_DAYS=60
OAUTH_RATE_LIMIT_PER_HOUR=600

# --- Historias y directos ----------------------------------------------------
STORY_TTL_HOURS=24
# El LiveKit del docker-compose de desarrollo usa estas credenciales.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- Notificaciones push -----------------------------------------------------
# Cuenta de servicio de Firebase, en JSON o base64. Sin ella sólo hay avisos
# dentro de la aplicación.
FIREBASE_SERVICE_ACCOUNT=

# --- Correo ------------------------------------------------------------------
# Con MAIL_ENABLED=false los correos se escriben en el registro en lugar de
# enviarse, que es lo cómodo en desarrollo.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Respet <no-reply@respet.app>"
SUPPORT_MAIL=

# --- Pagos -------------------------------------------------------------------
PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
# Id del webhook dado de alta en el panel de PayPal. Sin él las notificaciones
# no se pueden verificar y se descartan.
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=MXN

# --- Límite de peticiones ----------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
