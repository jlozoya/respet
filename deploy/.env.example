# Variables del despliegue de producción. Cópialo a `.env` en el servidor,
# junto a docker-compose.yml, y rellénalo. No lo subas al repositorio.

# --- Dominios -----------------------------------------------------------------
# Los tres tienen que apuntar (registro A/AAAA) a la IP del servidor.
DOMAIN=respet.app
API_DOMAIN=api.respet.app
LIVE_DOMAIN=live.respet.app
# Correo para Let's Encrypt: avisa si un certificado no se puede renovar.
ACME_EMAIL=admin@respet.app

# --- Imágenes -----------------------------------------------------------------
# El flujo de despliegue las fija a la versión recién compilada; a mano, `latest`.
API_IMAGE=ghcr.io/jlozoya/respet-api:latest
WEB_IMAGE=ghcr.io/jlozoya/respet-web:latest

# --- API ------------------------------------------------------------------------
# Orígenes que pueden llamar a la API desde un navegador: la web y la app nativa.
CORS_ORIGINS=https://respet.app,capacitor://localhost,https://localhost

# Genera cada secreto con: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Clave de 32 bytes para cifrar los secretos de la verificación en dos pasos:
#   openssl rand -base64 32
# No la cambies una vez en uso: los segundos factores dejarían de valer.
MFA_ENCRYPTION_KEY=

# --- Directos (LiveKit) --------------------------------------------------------
# Genera la clave y el secreto con: openssl rand -hex 16  /  openssl rand -base64 32
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Proveedores externos (opcionales) -----------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_MAPS_API_KEY=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Cuenta de servicio de Firebase, en base64, para las notificaciones push.
FIREBASE_SERVICE_ACCOUNT=

# --- Correo -------------------------------------------------------------------
MAIL_ENABLED=true
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Respet <no-reply@respet.app>"
SUPPORT_MAIL=

# --- Pagos --------------------------------------------------------------------
PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=production
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=MXN
