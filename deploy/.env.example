# Variables del despliegue de producción. Cópialo a `.env` en el servidor,
# junto a docker-compose.yml, y rellénalo. No lo subas al repositorio.

# --- Dominios -----------------------------------------------------------------
# Los tres tienen que apuntar (registro A/AAAA) a la IP del servidor.
DOMAIN=midominio.com
API_DOMAIN=api.midominio.com
LIVE_DOMAIN=live.midominio.com
# Correo para Let's Encrypt: avisa si un certificado no se puede renovar.
ACME_EMAIL=admin@midominio.com

# --- Imágenes -----------------------------------------------------------------
# El flujo de despliegue las fija a la versión recién compilada; a mano, `latest`.
API_IMAGE=ghcr.io/jlozoya/social-network-api:latest
WEB_IMAGE=ghcr.io/jlozoya/social-network-web:latest

# --- La marca -------------------------------------------------------------------
# Cómo se llama esto, de qué color es y dónde encontrarlo. Lo leen la API —que
# lo sirve en la consulta `branding`— y el contenedor de la web, para pintar la
# primera pantalla sin esperar a la API. Con cambiarlo y `docker compose up -d`
# basta: no hay que recompilar nada.
APP_NAME=Social Network
APP_TAGLINE=Comparte lo que te importa con quien te importa.
APP_DESCRIPTION=Una red social para contar lo que pasa a tu alrededor, seguir a quien te interesa y hablar con quien quieras.
# Logotipo horizontal para la cabecera; sin él se dibuja la inicial del nombre.
APP_LOGO_URL=
# Icono cuadrado para la pestaña del navegador y los correos.
APP_ICON_URL=
# Color principal; de él salen el resto de tonos de la interfaz. Entre
# comillas: sin ellas la almohadilla abriría un comentario.
APP_BRAND_COLOR="#f05a22"
APP_BRAND_GRADIENT="linear-gradient(135deg, #f05a22 0%, #f7931e 100%)"
# Enlaces y contacto que se enseñan en la aplicación.
APP_WEBSITE=https://midominio.com
APP_PUBLIC_MAIL=
APP_PHONE=
APP_ADDRESS=
APP_FACEBOOK=
APP_INSTAGRAM=

# --- API ------------------------------------------------------------------------
# Orígenes que pueden llamar a la API desde un navegador: la web y la app nativa.
CORS_ORIGINS=https://midominio.com,capacitor://localhost,https://localhost

# Genera cada secreto con: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Clave de 32 bytes para cifrar los secretos de la verificación en dos pasos:
#   openssl rand -base64 32
# No la cambies una vez en uso: los segundos factores dejarían de valer.
MFA_ENCRYPTION_KEY=

# --- Directos (LiveKit) --------------------------------------------------------
# Genera la clave y el secreto con: openssl rand -hex 16  /  openssl rand -base64 32
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Proveedores externos (opcionales) -----------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_MAPS_API_KEY=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Cuenta de servicio de Firebase, en base64, para las notificaciones push.
FIREBASE_SERVICE_ACCOUNT=

# --- Correo -------------------------------------------------------------------
MAIL_ENABLED=true
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Social Network <no-reply@midominio.com>"
SUPPORT_MAIL=

# --- Pagos --------------------------------------------------------------------
PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=production
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=MXN
