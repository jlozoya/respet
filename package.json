{
  "name": "respet",
  "version": "2.0.0",
  "private": true,
  "description": "Respet — red social para el cuidado, adopción y reporte de mascotas. Monorepo con app Ionic/Angular y API NestJS.",
  "license": "MIT",
  "author": "Fernando Lozoya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlozoya/respet.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "build": "npm run build:shared && npm run build:api && npm run build:mobile",
    "build:shared": "cd packages/shared && npm run build",
    "build:api": "cd apps/api && npm run build",
    "build:mobile": "cd apps/mobile && npm run build",
    "predev": "npm run build:shared",
    "dev": "concurrently -n api,mobile -c cyan,magenta \"npm:dev:api\" \"npm:dev:mobile\"",
    "dev:api": "cd apps/api && npm run start:dev",
    "dev:mobile": "cd apps/mobile && npm run start",
    "lint": "npm run lint:api && npm run lint:mobile",
    "lint:api": "cd apps/api && npm run lint",
    "lint:mobile": "cd apps/mobile && npm run lint",
    "test": "npm run test:api && npm run test:mobile",
    "test:api": "cd apps/api && npm run test",
    "test:mobile": "cd apps/mobile && npm run test:ci",
    "typecheck": "npm run typecheck:shared && npm run typecheck:api && npm run typecheck:mobile",
    "typecheck:shared": "cd packages/shared && npm run typecheck",
    "typecheck:api": "cd apps/api && npm run typecheck",
    "typecheck:mobile": "cd apps/mobile && npm run typecheck",
    "db:seed": "cd apps/api && npm run db:seed",
    "migrate:mongo": "cd apps/api && npm run migrate:mongo",
    "clean": "rimraf \"apps/*/dist\" \"apps/*/www\" \"apps/*/.angular\" \"packages/*/dist\"",
    "test:e2e": "cd apps/api && npm run test:e2e",
    "migrate:social": "cd apps/api && npm run migrate:social"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "rimraf": "^6.0.1",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "@swc/core@1.16.2": true,
    "esbuild@0.28.2": true,
    "esbuild@0.27.7": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "@parcel/watcher@2.6.0": true,
    "@apollo/protobufjs@1.2.8": true,
    "@scarf/scarf@1.4.0": false
  }
}
