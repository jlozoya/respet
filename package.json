{
  "name": "respet",
  "version": "2.0.0",
  "private": true,
  "description": "Respet — red social para el cuidado, adopción y reporte de mascotas. Monorepo con app Ionic/Angular y API NestJS.",
  "license": "MIT",
  "author": "Fernando Lozoya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlozoya/respetv2.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "build": "npm run build -w @respet/shared && npm run build -w @respet/api && npm run build -w @respet/mobile",
    "build:shared": "npm run build -w @respet/shared",
    "build:api": "npm run build -w @respet/api",
    "build:mobile": "npm run build -w @respet/mobile",
    "predev": "npm run build:shared",
    "dev": "concurrently -n api,mobile -c cyan,magenta \"npm:dev:api\" \"npm:dev:mobile\"",
    "dev:api": "npm run start:dev -w @respet/api",
    "dev:mobile": "npm run start -w @respet/mobile",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:seed": "npm run db:seed -w @respet/api",
    "migrate:mongo": "npm run migrate:mongo -w @respet/api",
    "clean": "rimraf \"apps/*/dist\" \"apps/*/www\" \"apps/*/.angular\" \"packages/*/dist\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "rimraf": "^6.0.1",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "@swc/core@1.16.2": true,
    "esbuild@0.28.2": true,
    "esbuild@0.27.7": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "@parcel/watcher@2.6.0": true,
    "@apollo/protobufjs@1.2.8": true,
    "@scarf/scarf@1.4.0": false
  }
}
