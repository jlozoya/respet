{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // tsup inyecta `baseUrl` al generar los .d.ts y TypeScript 6 lo marca como
    // obsoleto. Silenciarlo aquí evita que el build falle por una opción que
    // no fijamos nosotros.
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts"]
}
